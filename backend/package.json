{
  "name": "speed-alert-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API server and MySQL database for the Speed Alert app: community map, votes, police radar and backup.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "import-osm": "node --env-file-if-exists=.env src/scripts/import-osm.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
