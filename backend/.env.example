# Copy to .env and change the passwords before going live.
DATABASE_URL=mysql://speedalert:speedalert@127.0.0.1:3306/speedalert
TEST_DATABASE_URL=mysql://speedalert:speedalert@127.0.0.1:3306/speedalert_test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Behind a reverse proxy (nginx, Caddy, Railway...): the number of proxies,
# usually 1. On Railway it is 1 automatically. Leave false otherwise.
TRUST_PROXY=false
# Most points one driver can add in 24 hours
MAX_POINTS_PER_DAY=100
# Used by docker-compose for the MySQL container
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=speedalert
# Place search. Empty = free OpenStreetMap search. A Google "Places API (New)"
# key finds far more (every shop, restaurant, mall, building... worldwide).
# Keep the key secret: only here or in Railway's Variables, never in git.
GOOGLE_PLACES_KEY=
# Search shows this country's places first (two-letter code)
SEARCH_COUNTRY=iq
